{
  "name": "skelpro",
  "version": "1.5.3",
  "main": "./dist/src/index.js",
  "bin": {
    "skelpro": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "description": "SkelPro – where projects get their bones structured.",
  "scripts": {
