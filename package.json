    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "boilerplate",
    "automation",
    "developer-tool",
    "generator",
    "project",
    "setup",
    "templating",
    "template",
    "scaffold",
    "skeleton",
    "structure"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkelPro/skelpro.git"
  },
  "bugs": {
    "url": "https://github.com/SkelPro/skelpro/issues"
  },
  "homepage": "https://github.com/SkelPro/skelpro#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^13.0.0",
    "ignore": "^7.0.14",
    "inquirer": "^12.3.0",
    "minimatch": "^11.0.8",
    "ora": "^10.0.0",
    "tonelog": "^2.0.7",
    "typeglide": "^1.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.5",
    "ajv": "^8.20.0",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "$vite"
  }
